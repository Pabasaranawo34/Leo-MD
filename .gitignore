# ================================
# Leo MD - Git Ignore
# ================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ================================
# Environment / Secrets
# ================================

.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Keep the example environment file
!.env.example

# ================================
# WhatsApp / Baileys Sessions
# ================================

auth_info/
auth_info_*/
creds.json
session/
sessions/
*.session
*.session-journal

# ================================
# SQLite / Database
# ================================

data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ================================
# Downloads / Temporary Files
# ================================

downloads/*
!downloads/.gitkeep

tmp/
temp/
cache/

# ================================
# Logs
# ================================

*.log
logs/

# ================================
# Build / Generated Files
# ================================

dist/
build/
out/
.next/
.turbo/
coverage/

# ================================
# TypeScript
# ================================

*.tsbuildinfo

# ================================
# OS Files
# ================================

.DS_Store
Thumbs.db
desktop.ini

# ================================
# VS Code
# ================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ================================
# Docker
# ================================

.dockerignore

# ================================
# Miscellaneous
# ================================

*.bak
*.backup
*.tmp
*.swp
*.swo

# Leo MD owner configuration
data/owner.json